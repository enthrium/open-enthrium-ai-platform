{
    "name": "open-enthrium",
    "version": "1.5.3",
    "private":  true,
    "workspaces":  [
                       "server",
                       "processor",
                       "frontend"
                   ],
    "scripts":  {
                    "dev":  "concurrently \"yarn workspace @open-enthrium/server dev\" \"yarn workspace @open-enthrium/processor dev\" \"yarn workspace @open-enthrium/frontend dev\"",
                    "build":  "yarn workspace @open-enthrium/frontend build"
                },
    "devDependencies":  {
                            "concurrently":  "^8.2.2"
                        }
}
